From 2e20f69e58253cdc429bee67acdfddd397a7dfb8 Mon Sep 17 00:00:00 2001
From: Bloodlines Porter <noreply@invalid>
Date: Sat, 7 Nov 2026 06:58:32 +0200
Subject: [PATCH] fix(d3d9): bind index buffers with a 4-byte aligned length

---
 src/d3d9/d3d9_common_buffer.cpp |  2 +-
 src/d3d9/d3d9_device.cpp        | 12 +++++++-----
 2 files changed, 8 insertions(+), 6 deletions(-)

diff --git a/src/d3d9/d3d9_common_buffer.cpp b/src/d3d9/d3d9_common_buffer.cpp
index 36690ebb..70970fbb 100644
--- a/src/d3d9/d3d9_common_buffer.cpp
+++ b/src/d3d9/d3d9_common_buffer.cpp
@@ -96,7 +96,7 @@ namespace dxvk {
 
   Rc<DxvkBuffer> D3D9CommonBuffer::CreateBuffer() const {
     DxvkBufferCreateInfo  info;
-    info.size   = m_desc.Size;
+    info.size   = m_desc.Type == D3DRTYPE_INDEXBUFFER ? align(m_desc.Size, 4u) : m_desc.Size;
     info.usage  = 0;
     info.stages = 0;
     info.access = 0;
diff --git a/src/d3d9/d3d9_device.cpp b/src/d3d9/d3d9_device.cpp
index 4ecf356c..6ed94e7d 100644
--- a/src/d3d9/d3d9_device.cpp
+++ b/src/d3d9/d3d9_device.cpp
@@ -3218,17 +3218,19 @@ namespace dxvk {
     const uint32_t vertexBufferSize = GetUPBufferSize(MinVertexIndex + NumVertices, VertexStreamZeroStride);
 
     const uint32_t indexSize = IndexDataFormat == D3DFMT_INDEX16 ? 2 : 4;
-    const uint32_t indicesSize = vertexCount * indexSize;
+    const uint32_t indicesBytes = vertexCount * indexSize;
+    const uint32_t indexOffset = align(vertexBufferSize, 4u);
 
-    const uint32_t upSize = vertexBufferSize + indicesSize;
+    const uint32_t upSize = indexOffset + align(indicesBytes, 4u);
 
     auto upSlice = AllocUPBuffer(upSize);
     uint8_t* data = reinterpret_cast<uint8_t*>(upSlice.mapPtr);
     FillUPVertexBuffer(data, pVertexStreamZeroData, vertexDataSize, vertexBufferSize);
-    std::memcpy(data + vertexBufferSize, pIndexData, indicesSize);
+    std::memcpy(data + indexOffset, pIndexData, indicesBytes);
 
     EmitCs([this,
       cVertexSize   = vertexBufferSize,
+      cIndexOffset  = indexOffset,
       cBufferSlice  = std::move(upSlice.slice),
       cPrimType     = PrimitiveType,
       cPrimCount    = PrimitiveCount,
@@ -3244,7 +3246,7 @@ namespace dxvk {
       draw.instanceCount = drawInfo.instanceCount;
 
       ctx->bindVertexBuffer(0, cBufferSlice.subSlice(0, cVertexSize), cStride);
-      ctx->bindIndexBuffer(cBufferSlice.subSlice(cVertexSize, cBufferSlice.length() - cVertexSize), cIndexType);
+      ctx->bindIndexBuffer(cBufferSlice.subSlice(cIndexOffset, cBufferSlice.length() - cIndexOffset), cIndexType);
       ctx->drawIndexed(1u, &draw);
       ctx->bindVertexBuffer(0, DxvkBufferSlice(), 0);
       ctx->bindIndexBuffer(DxvkBufferSlice(), VK_INDEX_TYPE_UINT32);
@@ -7808,7 +7810,7 @@ namespace dxvk {
       VkIndexType indexType = DecodeIndexType(buffer->Desc()->Format);
 
       EmitCs([
-        cBufferSlice = buffer->GetBufferSlice<D3D9_COMMON_BUFFER_TYPE_REAL>(),
+        cBufferSlice = DxvkBufferSlice(buffer->GetBuffer<D3D9_COMMON_BUFFER_TYPE_REAL>(), 0, align(buffer->Desc()->Size, 4u)),
         cIndexType   = indexType
       ](DxvkContext* ctx) mutable {
         ctx->bindIndexBuffer(std::move(cBufferSlice), cIndexType);
-- 
2.54.0

